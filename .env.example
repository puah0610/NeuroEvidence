# Copy this file to .env. Demo mode requires no paid services.
DEMO_MODE=true

# Model Provider: "gemini" (recommended, free tier via Google AI Studio) or "openai"
LLM_PROVIDER=gemini

# Google AI Studio Gemini Settings (Free Tier)
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_INPUT_COST_PER_MILLION=0.0
GEMINI_OUTPUT_COST_PER_MILLION=0.0

# OpenAI Settings (Optional alternative)
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_JUDGE_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GENERATION_INPUT_COST_PER_MILLION=0.40
GENERATION_OUTPUT_COST_PER_MILLION=1.60
LLM_TEMPERATURE=0.0

# Verification & Retrieval Settings
EVIDENCE_THRESHOLD=0.65
ENABLE_NLI=false
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_MIN_CONFIDENCE=0.55
NLI_MIN_MARGIN=0.10
NLI_MAX_SALIENT_SENTENCES=3
DATABASE_PATH=data/app.db
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=neurology_corpus_v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CROSSREF_MAILTO=

# HyDE (Hypothetical Document Embeddings) + Smart Demo Mode
# When GEMINI_API_KEY is set and DEMO_MODE=true, the system activates two upgrades:
#   1. Smart Demo Mode — Gemini writes a real synthesised answer from retrieved demo chunks
#      instead of the copy-paste DemoGenerator template.
#   2. HyDE — Gemini silently generates a hypothetical clinical passage before retrieval
#      to improve which chunks get returned. The user never sees this passage.
# Set ENABLE_HYDE=false to disable HyDE query expansion only (Smart Demo Mode still active).
ENABLE_HYDE=true

# Langfuse Observability & Tracing (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
