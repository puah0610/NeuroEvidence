# Copy this file to .env. Demo mode requires no paid services.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GENERATION_INPUT_COST_PER_MILLION=0.40
GENERATION_OUTPUT_COST_PER_MILLION=1.60
EVIDENCE_THRESHOLD=0.65
ENABLE_NLI=false
NLI_MODEL=cross-encoder/nli-deberta-v3-base
DATABASE_PATH=data/app.db
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=neurology_corpus_v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CROSSREF_MAILTO=
